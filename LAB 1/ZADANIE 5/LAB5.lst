    75 0000009B BF01000000                  mov rdi, 1                      ; ekran
    76 000000A0 4889DE                      mov rsi, rbx                    ; adres poczatku tekstu
    77 000000A3 4C89D2                      mov rdx, r10                    ; ilosc znakow wraz z enterem
    78 000000A6 0F05                        syscall
    79                                  
