     1                                  section .bss
     2                                  
     3 00000000 <res 40h>                   bufor_wejscie resb 64           ; miejsce na wczytany tekst
     4 00000040 ????????????????            wynik         resq 1            ; miejsce w pamieci ram, przeznaczone dla liczby binarnej
     5 00000048 <res 20h>                   bufor_wyjscie resb 32           ; miejsce na tekst, ktory zostanie wyswietlony
     6                                  
     7                                  section .text
     8                                      global main
     9                                  
    10                                  main:
    11 00000000 55                          push rbp                        ; prolog
    12 00000001 4889E5                      mov rbp, rsp
    13                                  
    14                                      ; zadanie 5a	
    15                                      
    16 00000004 B800000000                  mov rax, 0                      ; odczyt
    17 00000009 BF00000000                  mov rdi, 0                      ; klawiatura
    18 0000000E 488D3425[00000000]          lea rsi, [bufor_wejscie]        ; adres pustego miejsca
    19 00000016 BA40000000                  mov rdx, 64                     ; max 64 znaki
    20 0000001B 0F05                        syscall
    21                                  
    22 0000001D 4889C1                      mov rcx, rax                    ; licznik wczytanych znakow
    23 00000020 48FFC9                      dec rcx                         ; dekrementuje by pozbyc sie entera
    24 00000023 488D1C25[00000000]          lea rbx, [bufor_wejscie]        ; rbx- wskaznik na wczytywany znak
    25 0000002B 41B800000000                mov r8, 0                       ; r8 ustawiam na 0, tu bedzie liczba
    26                                  
    27                                  .ascii_to_number:
    28                                  
    29 00000031 4883F900                    cmp rcx, 0                      ; sprawdzam czy to wszystkie znaki
    30 00000035 741C                        je .save_to_memory              ; tak == zapisuje w pamieci
    31                                  
    32 00000037 41B900000000                mov r9, 0
    33 0000003D 448A0B                      mov r9b, byte [rbx]             ; pobieram znak i czyszcze reszte rejestru
    34 00000040 4180E930                    sub r9b, 48                     ; odejmuje 48 by zamienic znak na cyfre
    35                                      
    36 00000044 4D6BC00A                    imul r8, 10                     ; mnoze, by stworzyc miejsce
    37 00000048 4D01C8                      add r8, r9                      ; dodaje nowa cyfre
    38                                  
    39 0000004B 48FFC3                      inc rbx                         ; increase ++ (biore nastepny znak)
    40 0000004E 48FFC9                      dec rcx                         ; decrease -- (zmniejszam licznik liter)
    41 00000051 EBDE                        jmp .ascii_to_number            ; wracam po nastepna cyfre jesli taka jest
    42                                  
    43                                  .save_to_memory:
    44                                  
    45 00000053 4C8D1425[40000000]          lea r10, [wynik]                ; pobranie adresu zmiennej wynikowej z pamieci
    46 0000005B 4D8902                      mov [r10], r8                   ; zapisuje w pamieci
    47                                  
    48                                  
    49                                      ; zadanie 5b
    50                                      
    51                                      
    52 0000005E 498B02                      mov rax, [r10]                  ; pobieram wartosc z pamieci do rax
    53 00000061 41BB0A000000                mov r11, 10                     ; dziele przez 10
    54                                  
    55 00000067 488D1C25[48000000]          lea rbx, [bufor_wyjscie]        ; rbx = wskaznik na bufor do wypisania
    56 0000006F 4883C31F                    add rbx, 31                     ; koniec bufora
    57 00000073 C6030A                      mov byte [rbx], 10              ; dodaje enter
    58 00000076 41BA01000000                mov r10, 1                      ; licznik odpowiadajacy za znaki juz zmienione
    59                                  
    60                                  .number_to_ascii:
    61                                  
    62 0000007C 48FFCB                      dec rbx                         ; cofam wskaznik w lewo przed zapisem cyfry --
    63 0000007F BA00000000                  mov rdx, 0                      ; ZAWSZE zeruje reszte (rdx) przed dzieleniem (div)
    64 00000084 49F7F3                      div r11                         ; rax / 10 (wynik idzie do rax, reszta do rdx)
    65                                  
    66 00000087 4883C230                    add rdx, 48                     ; dodaje 48 - zamieniam spowrotem na kod ascii
    67 0000008B 8813                        mov [rbx], dl                   ; zapisuje literke do bufora
    68                                  
    69 0000008D 49FFC2                      inc r10                         ; zwiekszam licznik gotowych znakow ++
    70 00000090 4883F800                    cmp rax, 0                      ; sprawdzam czy wszystkie elementy zostaly podzielone
    71 00000094 75E6                        jne .number_to_ascii            ; if != 0 powtarzam
    72                                  
    73                                  .print:
