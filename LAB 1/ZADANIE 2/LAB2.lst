     1                                  section .bss
     2 00000000 <res 40h>                   input_buffer  resb 64               ; miejsce na tekst wpisany przez uzytkownika
     3 00000040 <res 41h>                   output_buffer resb 65               ; miejsce przeznaczone na wypisanie wyniku zera jedynki +1
     4                                  
     5                                  section .text
     6                                      global main                      
     7                                  
     8                                  main:                                 
     9 00000000 55                          push rbp                            ; prolog
    10 00000001 4889E5                      mov rbp, rsp
    11                                  
    12 00000004 B800000000                  mov rax, 0                          ; odczytanie danych
    13 00000009 BF00000000                  mov rdi, 0                          ; klawiatura
    14 0000000E 488D3425[00000000]          lea rsi, [input_buffer]             ; adresowanie wzgledne, bo adres w pamieci ram sie zmienial
    15 00000016 BA40000000                  mov rdx, 64                         ; max liczba znakow
    16 0000001B 0F05                        syscall
    17                                  
    18 0000001D 4883F800                    cmp rax, 0                          ; if rax = 0, koniec programu
    19 00000021 0F8E92000000                jle .koniec
    20                                  
    21 00000027 4889C1                      mov rcx, rax                        ; licznik, ile znakow wpisano
    22 0000002A 48FFC9                      dec rcx                             ; pozbywamy sie znaku ENTERA
    23                                  
    24 0000002D 488D1C25[00000000]          lea rbx, [input_buffer]             ; pobranie adresu bufora wejsciowego lea wczytuje adres
    25 00000035 41B800000000                mov r8, 0                           ; miejsce na wynik liczby, zaczynam od 0
    26                                  
    27                                  .read_loop:
    28 0000003B 4883F900                    cmp rcx, 0                          ; sprawdzenie wszystkich znakow
    29 0000003F 7428                        je .print                           ; jesli tak, wypisuje 
    30                                  
    31 00000041 41B900000000                mov r9, 0                           ; czyszcze przed pobraniem nowego znaku
    32 00000047 448A0B                      mov r9b, byte [rbx]                 ; pobieram 1 bajt
    33                                  
    34                                      ; Sprawdzam, czy to cyfra czy litera
    35 0000004A 4180F939                    cmp r9b, '9'                        
    36 0000004E 7F06                        jg .is_letter                       ; Jeśli kod znaku > 9 to mam litere 
    37                                  
    38                                      ; Sprawdzenie dla cyfr
    39 00000050 4180E930                    sub r9b, 48                         ; zamiana na odpowiadajaca cyfre (0-9)
    40 00000054 EB04                        jmp .add_to_result                   
    41                                  
    42                                  .is_letter:
    43 00000056 4180E937                    sub r9b, 55                         ; zamiana literek od A do F na liczby
    44                                  
    45                                  .add_to_result:
    46 0000005A 4D6BC010                    imul r8, 16                         ; przesuniecie w lewo (mnozenie przez 16 to jak przesuniecie w systemie hex)
    47 0000005E 4D01C8                      add r8, r9                          ; dodanie nowej cyfry
    48                                  
    49 00000061 48FFC3                      inc rbx                             ; przejscie do kolejnego znaku
    50 00000064 48FFC9                      dec rcx                             ; zmniejszenie licznika petli
    51 00000067 EBD2                        jmp .read_loop                       
    52                                  
    53                                  ; zamiana liczby na tekst
    54                                  .print:
    55 00000069 4C89C0                      mov rax, r8                         ; kopiuje liczbe
    56 0000006C 41BB02000000                mov r11, 2                          ; dzielnik
    57                                  
    58 00000072 488D1C25[40000000]          lea rbx, [output_buffer]            ; wczytanie adresu poczatku
    59 0000007A 4883C340                    add rbx, 64                         ; przesuniecie na sam koniec bufora
    60                                  
    61 0000007E C6030A                      mov byte [rbx], 10                  ; dodaje znak nowej linii (enter)
    62 00000081 48FFCB                      dec rbx                             ; dekrementuje cofajac sie w lewo
    63 00000084 41BA01000000                mov r10, 1                          ; licznik gotowych znakow
    64                                  
    65                                  
    66                                  .divide_loop:
    67 0000008A BA00000000                  mov rdx, 0                          ; przed div ZAWSZE trzeba wyzerowac rejestr rdx!
    68 0000008F 49F7F3                      div r11                             ; dzielenie przez 10 
    69                                  
    70 00000092 4883C230                    add rdx, 48                         ; reszta z dzielenia (w rdx) zamieniana na kod ascii
    71 00000096 8813                        mov byte [rbx], dl                  ; zapisanie znaku do bufora
    72                                  
    73 00000098 48FFCB                      dec rbx                             ; przesuniecie w lewo dla kolejnej cyferki
    74 0000009B 49FFC2                      inc r10                             ; zwiekszenie licznika znakow
    75                                  
    76 0000009E 4883F800                    cmp rax, 0                          ; czy mamy jeszcze z czego dzielic?
    77 000000A2 75E6                        jne .divide_loop                    ; jesli nie, wracam po kolejna cyfre
    78                                  
    79                                  .result:
    80 000000A4 48FFC3                      inc rbx                             ; zwiekszam, bo petla zrobila jedno 'dec' za duzo
    81                                  
    82 000000A7 B801000000                  mov rax, 1                          ; wypisanie
    83 000000AC BF01000000                  mov rdi, 1                          ; ekrna
    84 000000B1 4889DE                      mov rsi, rbx                        ; adres pierwszego wypisywanego znaku
    85 000000B4 4C89D2                      mov rdx, r10                        ; ilosc znakow
    86 000000B7 0F05                        syscall
    87                                  
    88                                  .koniec:
    89 000000B9 4889EC                      mov rsp, rbp                        ; epilog funkcji
    90 000000BC 5D                          pop rbp
    91                                  
    92 000000BD B83C000000                  mov rax, 60                         ; wyjscie
    93 000000C2 BF00000000                  mov rdi, 0                          ; sukces
    94 000000C7 0F05                        syscall
