     1                                  section .data
     2                                  
     3 00000000 4E6965706F70726177-         msg db "Niepoprawny znak/i", 10
     3 00000009 6E79207A6E616B2F69-
     3 00000012 0A                 
     4                                      msg_len equ $ - msg                 ; automatycznie liczy dlugosc tekstu
     5                                  
     6                                  section .bss
     7                                  
     8 00000000 <res 40h>                   input_buffer  resb 64               ; miejsce na tekst wpisany przez uzytkownika
     9 00000040 <res 41h>                   output_buffer resb 65               ; miejsce przeznaczone na wypisanie wyniku zera jedynki +1
    10                                  
    11                                  section .text
    12                                  
    13                                      global main                      
    14                                  
    15                                  main:                                 
    16 00000000 55                          push rbp                            ; prolog
    17 00000001 4889E5                      mov rbp, rsp
    18                                  
    19 00000004 B800000000                  mov rax, 0                          ; odczytanie danych
    20 00000009 BF00000000                  mov rdi, 0                          ; klawiatura
    21 0000000E 488D3425[00000000]          lea rsi, [input_buffer]             ; adresowanie wzgledne, bo adres w pamieci ram sie zmienial
    22 00000016 BA40000000                  mov rdx, 64                         ; max liczba znakow
    23 0000001B 0F05                        syscall
    24                                  
    25 0000001D 4883F800                    cmp rax, 0                          ; if rax = 0, koniec programu
    26 00000021 0F8EBF000000                jle .koniec
    27                                  
    28 00000027 4889C1                      mov rcx, rax                        ; licznik, ile znakow wpisano
    29 0000002A 48FFC9                      dec rcx                             ; pozbywamy sie znaku ENTERA
    30                                  
    31 0000002D 488D1C25[00000000]          lea rbx, [input_buffer]             ; pobranie adresu bufora wejsciowego lea wczytuje adres
    32 00000035 41B800000000                mov r8, 0                           ; miejsce na wynik liczby, zaczynam od 0
    33                                  
    34                                  .read_loop:
    35                                  
    36 0000003B 4883F900                    cmp rcx, 0                          ; sprawdzenie wszystkich znakow
    37 0000003F 743A                        je .print                           ; jesli tak, wypisuje 
    38                                  
    39 00000041 41B900000000                mov r9, 0                           ; czyszcze przed pobraniem nowego znaku
    40 00000047 448A0B                      mov r9b, byte [rbx]                 ; pobieram 1 bajt
    41                                  
    42 0000004A 4180F930                    cmp r9b, '0'                        ; czy znak jest przed '0' w tabeli ascii
    43 0000004E 7C7D                        jl .invalid_char                    ; tak == blad
    44                                  
    45 00000050 4180F939                    cmp r9b, '9'                        ; czy to cyfra od '0' do '9'?
    46 00000054 7E12                        jle .is_digit                       ; jesli tak == is_digit
    47                                  
    48 00000056 4180F941                    cmp r9b, 'A'                        ; czy znak znajduje sie miedzy '9' a 'A' czyli znaki inne niz litery oraz cyfry
    49 0000005A 7C71                        jl .invalid_char                    ; tak == blad
    50                                  
    51 0000005C 4180F946                    cmp r9b, 'F'                        ; czy znak jest poza zakresem A-F (np. G, Z, male litery)?
    52 00000060 7F6B                        jg .invalid_char                    ; jesli tak, skacz do bledu
    53                                  
    54                                  
    55                                  .is_letter:
    56                                  
    57 00000062 4180E937                    sub r9b, 55                         ; zamiana literek od A do F na liczby
    58 00000066 EB04                        jmp .add_to_result
    59                                  
    60                                  .is_digit:
    61                                  
    62 00000068 4180E930                    sub r9b, 48                         ; zamiana na odpowiadajaca cyfre 0-9
    63                                  
    64                                  .add_to_result:
    65 0000006C 4D6BC010                    imul r8, 16                         ; przesuniecie w lewo (mnozenie przez 16 to jak przesuniecie w systemie hex)
    66 00000070 4D01C8                      add r8, r9                          ; dodanie nowej cyfry
    67                                  
    68 00000073 48FFC3                      inc rbx                             ; przejscie do kolejnego znaku
    69 00000076 48FFC9                      dec rcx                             ; zmniejszenie licznika petli
    70 00000079 EBC0                        jmp .read_loop                       
    71                                  
    72                                  ; zamiana liczby na tekst
    73                                  
    74                                  .print:
    75 0000007B 4C89C0                      mov rax, r8                         ; kopiuje liczbe
    76 0000007E 41BB02000000                mov r11, 2                          ; dzielnik (wypisze jako binarne zera i jedynki)
    77                                  
    78 00000084 488D1C25[40000000]          lea rbx, [output_buffer]            ; wczytanie adresu poczatku
    79 0000008C 4883C340                    add rbx, 64                         ; przesuniecie na sam koniec bufora
    80                                  
    81 00000090 C6030A                      mov byte [rbx], 10                  ; dodaje znak nowej linii (enter)
    82 00000093 48FFCB                      dec rbx                             ; dekrementuje cofajac sie w lewo
    83 00000096 41BA01000000                mov r10, 1                          ; licznik gotowych znakow
    84                                  
    85                                  
    86                                  .divide_loop:
    87 0000009C BA00000000                  mov rdx, 0                          ; przed div ZAWSZE trzeba wyzerowac rejestr rdx!
    88 000000A1 49F7F3                      div r11                             ; dzielenie przez 2 
    89                                  
    90 000000A4 4883C230                    add rdx, 48                         ; reszta z dzielenia rdx - zamieniam na kod ascii
    91 000000A8 8813                        mov byte [rbx], dl                  ; zapisanie znaku do bufora
    92                                  
    93 000000AA 48FFCB                      dec rbx                             ; przesuniecie w lewo dla kolejnej cyferki
    94 000000AD 49FFC2                      inc r10                             ; zwiekszenie licznika znakow
    95                                  
    96 000000B0 4883F800                    cmp rax, 0                          ; czy mamy jeszcze z czego dzielic?
    97 000000B4 75E6                        jne .divide_loop                    ; jesli nie, wracam po kolejna cyfre
    98                                  
    99                                  .result:
   100 000000B6 48FFC3                      inc rbx                             ; zwiekszam, bo petla zrobila jedno 'dec' za duzo
   101                                  
   102 000000B9 B801000000                  mov rax, 1                          ; wypisanie (sys_write)
   103 000000BE BF01000000                  mov rdi, 1                          ; stdout
   104 000000C3 4889DE                      mov rsi, rbx                        ; adres pierwszego wypisywanego znaku
   105 000000C6 4C89D2                      mov rdx, r10                        ; ilosc znakow
   106 000000C9 0F05                        syscall
   107 000000CB EB19                        jmp .koniec                         ; upewniam sie, ze po wypisaniu wlasciwego wyniku omijam wyswietlanie bledu!
   108                                  
   109                                  .invalid_char:
   110 000000CD B801000000                  mov rax, 1                          ; wypisanie bledu
   111 000000D2 BF01000000                  mov rdi, 1                          ; monitor
   112 000000D7 488D3425[00000000]          lea rsi, [msg]                      ; adres komunikatu o bledzie z sekcji data
   113 000000DF BA13000000                  mov rdx, msg_len                    ; automatycznie policzona ilosc znakow
   114 000000E4 0F05                        syscall
   115                                  
   116                                  .koniec:
   117 000000E6 4889EC                      mov rsp, rbp                        ; epilog funkcji
   118 000000E9 5D                          pop rbp
   119                                  
   120 000000EA B83C000000                  mov rax, 60                         ; wyjscie
   121 000000EF BF00000000                  mov rdi, 0                          ; sukces
   122 000000F4 0F05                        syscall
