     1                                  section .bss                    ; zmienne w sekcji .bss nie maja zadnej wartosci
     2                                                                  ; wartosci zostana przypisane po uruchomieniu programu
     3 00000000 <res 100h>                  bufor resb 256              ; rezerwacja 256 bajtow
     4                                  
     5                                  section .text
     6                                      global main
     7                                  
     8                                  main:   
     9 00000000 55                          push rbp                    ;
    10 00000001 4889E5                      mov rbp, rsp
    11                                  
    12                                                                  ; mov(e) kopiuje zrodlo do celu
    13 00000004 B800000000                  mov rax, 0                  ; odczyt (read)
    14 00000009 BF00000000                  mov rdi, 0                  ; wejscie (klawiatura)
    15 0000000E 488D3425[00000000]          lea rsi, [bufor]            ; adres pustego miejsca
    16 00000016 BA00010000                  mov rdx, 256                ; ograniczenie wczytania do max 256 znakow
    17 0000001B 0F05                        syscall                     ; wywolanie systemu operacyjnego
    18                                  
    19 0000001D 4989C0                      mov r8, rax                 ; dlugosc wczytanego tekstu kopiuje do r8
    20 00000020 4889C1                      mov rcx, rax                ; kopiuje, by uzyc jako licznika w petli
    21 00000023 488D1C25[00000000]          lea rbx, [bufor]            ; poczatek wczytanego tekstu
    22                                  
    23 0000002B 41B901000000                mov r9, 1
    24                                  
    25                                      ; flagi:
    26                                      ; jl - skocz, jesli mniejsze
    27                                      ; jle - skocz, jesli mniejsze lub rowne
    28                                      ; je - skocz, jesli rowne
    29                                  
    30                                      ; rax - 64bitowy rejest
    31                                      ; eax - 32
    32                                      ; ax -16
    33                                      ; al - 8 bitow = 1bajt = 1literka
    34                                  
    35                                  .loop_start:                    ; petla
    36 00000031 4883F900                    cmp rcx, 0                  ; warunek - czy 0? compare
    37 00000035 7446                        je .print                   ; jesli tak - wypisuje - koncze sprawdzanie
    38                                      
    39 00000037 8A03                        mov al, byte [rbx]          ; pobranie jednego znaku do rejestru al
    40                                  
    41                                  ; Sprawdzenie, czy sa to wielkie litery
    42                                  
    43 00000039 3C41                        cmp al, 'A'
    44 0000003B 7C38                        jl .skip                    ; jesli znak ma kod ascii przed 'A' - pomijam
    45 0000003D 3C5A                        cmp al, 'Z'
    46 0000003F 7E0A                        jle .capital_letter         ; jesli znak znajduje sie pomiedzy 'A' a 'Z' wiem ze to wielka litera
    47                                      
    48                                  ; Sprawdzenie, czy sa to male litery
    49                                  ; ta sama logika tylko dla malych literek
    50 00000041 3C61                        cmp al, 'a'
    51 00000043 7C30                        jl .skip
    52 00000045 3C7A                        cmp al, 'z'
    53 00000047 7E0E                        jle .small_letter
    54                                  
    55 00000049 EB2A                        jmp .skip
    56                                  
    57                                  .capital_letter:
    58 0000004B 4983F901                    cmp r9, 1                   ; sprawdzenie wartosci
    59 0000004F 7510                        jne .change_value
    60                                  
    61 00000051 0420                        add al, 32                  ; zamieniam wielka litere na mala dodajac do jej kodu ascii 32
    62 00000053 8803                        mov byte [rbx], al          ; zamieniam znak w pamieci
    63 00000055 EB0A                        jmp .change_value
    64                                  
    65                                  .small_letter:
    66 00000057 4983F901                    cmp r9, 1
    67 0000005B 7504                        jne .change_value
    68 0000005D 2C20                        sub al, 32                  ; zamieniam na mala litere odejmujac od kodu ascii litery liczbe 32
    69 0000005F 8803                        mov byte [rbx], al          ; zamieniam znak w pamieci
    70                                  
    71                                  .change_value:
    72 00000061 4983F901                    cmp r9, 1
    73 00000065 7408                        je .zero                    ; jesli bylo 1 - zamieniam na 0
    74 00000067 41B901000000                mov r9, 1
    75 0000006D EB06                        jmp .skip
    76                                  
    77                                  .zero:
    78 0000006F 41B900000000                mov r9, 0                   ; zamiana na 0
    79                                  
    80                                  .skip:
    81 00000075 48FFC3                      inc rbx                     ; increase ++
    82 00000078 48FFC9                      dec rcx                     ; decrease --
    83 0000007B EBB4                        jmp .loop_start             ; sprawdzam kolejny znak
    84                                  
    85                                  .print:
    86 0000007D B801000000                  mov rax, 1                  ; wypisanie
    87 00000082 BF01000000                  mov rdi, 1                  ; ekran monitora
    88 00000087 488D3425[00000000]          lea rsi, [bufor]            ; adres tekstu, ktory zostal przerobiony
    89 0000008F 4C89C2                      mov rdx, r8                 ; ilosc znakow zapisana wczesniej w r8
    90 00000092 0F05                        syscall
    91                                  
    92 00000094 4889EC                      mov rsp, rbp                ;
    93 00000097 5D                          pop rbp
    94                                  
    95 00000098 B83C000000                  mov rax, 60                 ; wyjscie z programu
    96 0000009D BF00000000                  mov rdi, 0                  ; sukces
    97 000000A2 0F05                        syscall
