     1                                  section .data
     2                                      global zmienna_asm     ; eksportuje zmienna, by bylo ja widac w C
     3                                      global STALA_ASM
     4                                      
     5                                      ; definiuje zmienna w pamieci (32-bitowa, bo int w C ma 32 bity), ktora bedzie przechowywac wartosc, do ktorej dodam stala zdefiniowana w C
     6                                      ; dd oznacza "define double word", czyli rezerwuje 4 bajty (32 bity) w pamieci dla tej zmiennej, i inicjalizuje ja wartoscia 10
     7 00000000 0A000000                    zmienna_asm dd 10      
     8                                      
     9                                      ; definiuje stala w pamieci (32-bitowa, bo int w C ma 32 bity), ktora bedzie dodawana do zmiennej_asm w funkcji dodaj_w_asm
    10 00000004 5A000000                    STALA_ASM   dd 90      
    11                                  
    12                                  section .text
    13                                      ; sluzy do wyslania danych
