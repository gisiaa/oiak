     1                                  section .text
     2                                      global dodaj_do_drugiego_elementu
     3                                      global dodaj_zmienne_w_asm
     4                                  
     5                                      extern zmienna_c
     6                                      extern STALA_C
     7                                      extern tablica_c
     8                                  
     9                                  ; dodaje zmienna_c do drugiego elementu tablicy
    10                                  dodaj_do_drugiego_elementu:
    11 00000000 55                          push rbp
    12 00000001 4889E5                      mov rbp, rsp
    13                                  
    14 00000004 8B0425[00000000]            mov eax, dword [zmienna_c]      ; eax = zmienna_c
    15 0000000B 010425[04000000]            add dword [tablica_c + 4], eax  ; tablica_c[1] = tablica_c[1] + zmienna_c
    16                                  
    17 00000012 4889EC                      mov rsp, rbp
    18 00000015 5D                          pop rbp
    19 00000016 C3                          ret
    20                                  
    21                                  ; osobno dodaje do siebie zmienne: zmienna_c + STALA_C
    22                                  dodaj_zmienne_w_asm:
    23 00000017 55                          push rbp
    24 00000018 4889E5                      mov rbp, rsp
    25                                  
    26 0000001B 8B0425[00000000]            mov eax, dword [zmienna_c]
    27 00000022 030425[00000000]            add eax, dword [STALA_C]
    28                                  
    29 00000029 4889EC                      mov rsp, rbp
    30 0000002C 5D                          pop rbp
    31 0000002D C3                          ret
