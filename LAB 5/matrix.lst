    59                                  
    60 0000004D 48FFC9                      dec  rcx                                   ; wykonuje ten krok programu
    61 00000050 75EE                        jnz  .loop_seq                             ; wracam do petli jesli jeszcze nie koniec
    62                                  
    63                                      ; koncze pomiar czasu
    64 00000052 0F01F9                      rdtscp                                     ; pobieram licznik cykli na koncu
    65 00000055 48C1E220                    shl  rdx, 32                               ; przesuwam starsza czesc wyniku (shift left 32 bity w lewo)
    66 00000059 4809D0                      or   rax, rdx                              ; skladam licznik cykli w calosc (mlodze bity z rax, starsze z rdx)
    67 0000005C 488945E0                    mov  [rbp-32], rax                         ; zapisuje albo pobieram czas koncowy
    68 00000060 31C0                        xor  eax, eax                              ; zeruje eax
    69 00000062 0FA2                        cpuid                                      ; porzadkuje instrukcje i pobieram info o CPU
    70                                  
