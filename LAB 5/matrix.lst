   192 00000152 83F806                      cmp  eax, 6                                ; sprawdzam czy XMM i YMM sa wlaczone
   193 00000155 7507                        jne  .no                                   ; skacze jesli wartosci sa rozne
   194                                  
   195 00000157 B801000000                  mov  eax, 1                                ; zwracam 1 jako sukces
   196 0000015C 5B                          pop  rbx                                   ; przywracam rbx
   197 0000015D C3                          ret                                        ; wracam do funkcji wywolujacej
   198                                  
