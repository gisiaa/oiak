    72 00000068 482B45E8                    sub  rax, [rbp-24]                         ; licze roznice cykli
    73                                  
    74 0000006C 4883C428                    add  rsp, 40                               ; zwalniam miejsce na stosie
    75 00000070 5B                          pop  rbx                                   ; przywracam rbx
    76 00000071 5D                          pop  rbp                                   ; przywracam rbp
    77 00000072 C3                          ret                                        ; wracam do funkcji wywolujacej
