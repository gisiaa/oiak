   173                                  ; sprawdzam AVX, FMA, OSXSAVE i stan XMM/YMM w XCR0
   174                                  check_avx_fma:                                 ; zaczynam sprawdzanie AVX i FMA
   175 00000130 53                          push rbx                                   ; zabezpieczam rbx przed zmiana
   176                                  
   177 00000131 B801000000                  mov  eax, 1                                ; zwracam 1 jako sukces
   178 00000136 0FA2                        cpuid                                      ; porzadkuje instrukcje i pobieram info o CPU
   179                                  
   180 00000138 0FBAE11B                    bt   ecx, 27                               ; sprawdzam bit OSXSAVE
   181 0000013C 7320                        jnc  .no                                   ; skacze jesli bit nie byl ustawiony
   182                                  
   183 0000013E 0FBAE11C                    bt   ecx, 28                               ; sprawdzam bit AVX
   184 00000142 731A                        jnc  .no                                   ; skacze jesli bit nie byl ustawiony
   185                                  
   186 00000144 0FBAE10C                    bt   ecx, 12                               ; sprawdzam bit FMA
   187 00000148 7314                        jnc  .no                                   ; skacze jesli bit nie byl ustawiony
   188                                  
   189 0000014A 31C9                        xor  ecx, ecx                              ; zeruje ecx przed xgetbv
   190 0000014C 0F01D0                      xgetbv                                     ; sprawdzam ustawienia systemu dla AVX
