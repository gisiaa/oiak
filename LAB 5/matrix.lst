   243 000001B3 4D6BDB20                    imul r11, 32                               ; licze przesuniecie wiersza
   244 000001B7 4C01D8                      add  rax, r11                              ; dodaje przesuniecie do adresu
   245 000001BA 4D89CB                      mov  r11, r9                               ; kopiuje j do rejestru pomocniczego
   246 000001BD 49C1E303                    shl  r11, 3                                ; licze przesuniecie elementu double
   247 000001C1 4C01D8                      add  rax, r11                              ; dodaje przesuniecie do adresu
   248 000001C4 F20F1010                    movsd xmm2, qword [rax]                    ; wczytuje element z macierzy B
