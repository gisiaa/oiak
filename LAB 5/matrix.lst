   207                                  seq_multi4x4:                                  ; zaczynam skalarne mnozenie macierzy
   208 00000162 55                          push rbp                                   ; zapisuje stare rbp na stosie
   209 00000163 4889E5                      mov  rbp, rsp                              ; ustawiam rbp jako baze stosu
