    49                                      ; zabezpieczam argumenty, zeby kolejne powtorzenia zawsze mialy te same adresy
    50 00000040 51                          push rcx                                   ; zapisuje licznik petli
    51 00000041 52                          push rdx                                   ; zapisuje adres wyniku
