     1                                  extern printf ; funkcje zewnetrzne z biblioteki C
     2                                  extern scanf
     3                                  
     4                                  ; DANE ZAINICJALIZOWANE - wartosci znane
     5                                  
     6                                  section .data
     7 00000000 506F64616A207A616B-         msg1 db "Podaj zakres gorny przedzialu: ", 0
     7 00000009 72657320676F726E79-
     7 00000012 2070727A65647A6961-
     7 0000001B 6C753A2000         
     8 00000020 256C6400                    fmt1 db "%ld", 0 ; ld - 64bitowa liczba calkowita long
     9 00000024 4C69637A6279207069-         msg2 db "Liczby pierwsze z przedzialu [2...%ld]: ", 10, 0 ; 10 to znak nowej linii, 0 to ENTER
     9 0000002D 657277737A65207A20-
     9 00000036 70727A65647A69616C-
     9 0000003F 75205B322E2E2E256C-
     9 00000048 645D3A200A00       
    10 0000004E 256C642000                  fmt2 db "%ld ", 0
    11                                  
    12                                  ; DANE NIEZAINICJALIZOWANE    
    13                                  
    14                                  section .bss
    15 00000000 ????????????????            number resq 1 ; poczworne slowo
    16 00000008 <res F4245h>                table resb 1000005
    17                                  
    18                                  section .text
    19                                      global main
    20                                  
    21                                  main: ; 1x8bajtow
    22 00000000 55                          push rbp ; wskaznik na stosu 2x8
    23 00000001 4889E5                      mov rbp, rsp ; zapisuje wskaznik
    24                                  
    25                                  ; REJESTRY NIEULOTNE - uzywam ich poniewaz funkcje z C niszcza warotisc w rejestrach ulotnych
    26                                  ; w ten sposob chce zabezpieczyc zmienne np licznik w petli
    27                                  ; wartosci rejestrow nieulotnych nie da sie zmienic!!!
    28                                  ; ale trzeba zwrocic je w tym samym stanie - taki wymog
    29 00000004 4154                        push r12 ; zapisuje 12 na stos, rsp (wskaznik) maleje o 8 bajtow 3x8
    30 00000006 4155                        push r13 ; itd. 4x8
    31 00000008 4156                        push r14 ; 5x8
    32 0000000A 4157                        push r15 ; 6x8
    33                                  
    34                                  ; WYROWNANIE STOSU
    35                                  
    36                                  ; stos musi byc wyrownany do wielokrotnosci 16 bajtow
    37                                  ; jest poniewaz 6x8 = 48bajtow - wielokrotnosc 16
    38                                  
    39                                  ; funkcja napisana w C -> kolejnosc przekazywania argumentow: rdi, rsi, rdx, rcx...
    40                                  
    41 0000000C 48BF-                   mov rdi, msg1
    41 0000000E [0000000000000000] 
    42 00000016 B800000000              mov rax, 0 ; zeruje rax - brak wartosci zmiennoprzecinkowych
    43 0000001B E8(00000000)            call printf
    44                                  
    45 00000020 48BF-                   mov rdi, fmt1 ; %ld
    45 00000022 [2000000000000000] 
    46 0000002A 48BE-                   mov rsi, number ; adres pamieci do ktorego wpisze liczbe trafia do rsi
    46 0000002C [0000000000000000] 
    47 00000034 B800000000              mov rax, 0 ; brak liczb zmiennoprzecinkowych
    48 00000039 E8(00000000)            call scanf
    49                                  
    50 0000003E 4C8B3C25[00000000]      mov r15, [number] ; [] - pobieranie wartosci spod adresu, nie adresu
    51                                  
    52 00000046 B902000000              mov rcx, 2 ; licznik petli (i = 2) c w rcx pochodzi od COUNTER
    53                                  
    54                                  .ONEloop: ; wypelniam tablice 1
    55 0000004B 4C39F9                      cmp rcx, r15 ; (compare) porownuje licznik z gornym zakresem N
    56 0000004E 7F0C                        jg .TWO ; SKOCZ JESI WIEKSZE i > N
    57                                  
    58 00000050 C681[08000000]01            mov byte [table + rcx], 1 ; byte - 8 bitow, [table + rcx] przesuniecie w pamieci o wartosc z rej rcx
    59 00000057 48FFC1                      inc rcx ; inkrementuje licznik
    60                                  
    61 0000005A EBEF                        jmp .ONEloop ; bezwarunkowy skok na poczatek petli
    62                                  
    63                                  .TWO:
    64 0000005C 41BC02000000                mov r12, 2 ; wstawiam (kopiujac) 2 do rejestru r12, bo sito liczy od 2 (najmniejsza liczba pierwsza)
    65                                  
    66                                  .SITOloop:
    67 00000062 4C89E0                      mov rax, r12; kopiuje i do rax
    68 00000065 490FAFC4                    imul rax, r12; mnoze i*i
    69 00000069 4C39F8                      cmp rax, r15 ; sprawdzam, czy i*i <=N
    70 0000006C 7F25                        jg .ENDSITOloop ; jesli wynik mnozenia wiekszy, koniec wykreslania wielokrotnosci
    71                                  
    72 0000006E 4180BC24[08000000]-         cmp byte [table + r12], 1 ; srpawdzam czy aktualna wartosc liczby jest dalej rowna 1
    72 00000076 01                 
    73 00000077 7515                        jne .SKIPSITOINNERloop ; skocz, jesli nierowne 1
    74                                  
    75 00000079 4989C5                      mov r13, rax; r13 odpowiada teraz j = i*i
    76                                  
    77                                  .SITOINNERloop:
    78 0000007C 4D39FD                      cmp r13, r15 ; porownuje wielokrotnosc j z N
    79 0000007F 7F0D                        jg .SKIPSITOINNERloop; przerywam petle, jesli j > N 
    80 00000081 41C685[08000000]00          mov byte [table + r13], 0 ; wykreslam liczbe z sita, ustawiajac n na 0 (false)
    81 00000089 4D01E5                      add r13, r12 ; przechodze do kolejnej wieloktonosci j = j + 1
    82 0000008C EBEE                        jmp .SITOINNERloop
    83                                  
    84                                  .SKIPSITOINNERloop:
    85 0000008E 49FFC4                      inc r12 ; zwiekszam licznik petli
    86 00000091 EBCF                        jmp .SITOloop ; powrot do petli zewnetrznej
    87                                  
    88                                  .ENDSITOloop:
    89 00000093 48BF-                       mov rdi, msg2 ; print
    89 00000095 [2400000000000000] 
    90 0000009D 4C89FE                      mov rsi, r15 ; N trafia jako argument liczbowy
    91 000000A0 B800000000                  mov rax, 0
    92 000000A5 E8(00000000)                call printf
    93                                  
    94 000000AA 41BC02000000                mov r12, 2 ; resetuje licznik i na 2
    95                                  
    96                                  .PRINTloop:
    97 000000B0 4D39FC                      cmp r12, r15; sprawdzam, czy i <= N
    98 000000B3 7F27                        jg .ENDPRINTloop ; koniec wypisywania, caly zakres sprawdzony
    99                                  
   100 000000B5 4180BC24[08000000]-         cmp byte [table + r12], 1; sprawdzam, czy znajduje sie pod tym adresem liczba pierwsza
   100 000000BD 01                 
   101 000000BE 7517                        jne .SKIPPRINTloop; jesli nie, SKIP
   102                                  
   103 000000C0 48BF-                       mov rdi, fmt2 ; %ld
   103 000000C2 [4E00000000000000] 
   104 000000CA 4C89E6                      mov rsi, r12 ; znaleziona liczba pierwsza
   105 000000CD B800000000                  mov rax, 0
   106 000000D2 E8(00000000)                call printf
   107                                  
   108                                  .SKIPPRINTloop:
   109 000000D7 49FFC4                      inc r12 ; spr kolejna liczbe w tablicy
   110 000000DA EBD4                        jmp .PRINTloop ; powtarzam
   111                                  
   112                                  .ENDPRINTloop:
   113                                      ; ostatni na wejsciu, pierwszy na wyjsciu
   114 000000DC 415F                        pop r15 ; zdejmuje r15 ze stosu, wskaznik rsp zwieksza sie o 8 bajtow
   115 000000DE 415E                        pop r14 ; itd
   116 000000E0 415D                        pop r13 ;
   117 000000E2 415C                        pop r12 ;
   118                                  
   119 000000E4 4889EC                      mov rsp, rbp ; resetuje wskaznik stosu
   120 000000E7 5D                          pop rbp ; zdejmuje wskaznik - niszcze ramke stosu, bo bez tego ret pobraloby losowe liczby
   121                                  
   122 000000E8 B800000000                  mov rax, 0 ; kod sukcesu, wyjscie z programu
   123 000000ED C3                          ret
