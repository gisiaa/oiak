     1                                  READ_NR equ 0 ; numer wywolania READ
     2                                  WRITE_NR equ 1 ; numer wywolania WRITE
     3                                  
     4                                  STDIN equ 0 ; wejscie - klawiatura
     5                                  STDOUT equ 1 ; weyjscie - ekran
     6                                  
     7                                  MAX_NUMBERS equ 1024*1024*16
     8                                  BYTES_PER_NUMBER equ 8 ; 64 bitow -> 8 bajtow
     9                                  MAX_BYTES equ MAX_NUMBERS * BYTES_PER_NUMBER
    10                                  
    11                                  ; ZMIENNE NIEZAINICJALIZOWANE - miejsce zarezerwowane wypelnione zerami
    12                                  section .bss
    13 00000000 <res 8000000h>              numbers resb MAX_BYTES ; tablica
    14 08000000 ????????????????            nBytes resq 1 ; 64 bity - poczworne slowo - licznik wczytanych bajtow
    15 08000008 ????????????????            nNumbers resq 1 ; 64 bity - liczba elementow (N)
    16                                  
    17                                  ; ciag liczb do testow: zzzzzzzzaaaaaaaabbbbbbbbgggggggg
    18                                  section .text
    19                                      global main
    20                                  
    21                                  main:
    22 00000000 55                          push rbp ; zapisuje wskaznik na stosie
    23 00000001 4889E5                      mov rbp, rsp ; nowy wskaznik
    24                                  
    25 00000004 B800000000                  mov rax, READ_NR ; READ
    26 00000009 BF00000000                  mov rdi, STDIN ; klawiatura
    27 0000000E 48BE-                       mov rsi, numbers ; zapis do tablicy
    27 00000010 [0000000000000000] 
    28 00000018 BA00000008                  mov rdx, MAX_BYTES ; limit rozmiaru
    29 0000001D 0F05                        syscall
    30                                  
    31 0000001F 48890425[00000008]          mov [nBytes], rax ; rax - zapisuje liczbe wczytanych bajtow 
    32 00000027 4883F801                    cmp rax, 1
    33 0000002B 0F8C89000000                jl .noDataRead ; skocz, jesli mniejsze rax < 1
    34                                  
    35 00000031 BB08000000                  mov rbx, BYTES_PER_NUMBER
    36 00000036 4831D2                      xor rdx, rdx ; 
    37 00000039 48F7F3                      div rbx
    38                                  
    39 0000003C 4883FA00                    cmp rdx, 0
    40 00000040 757F                        jne .wrongNumberOfBytes ; skocz jesli nie rowne
    41                                  
    42 00000042 48890425[08000008]          mov [nNumbers], rax ; rax zawiera teraz wyliczone N 
    43                                  
    44 0000004A 4889C7                      mov rdi, rax ; rdi - granica N w petli 
    45 0000004D 48FFCF                      dec rdi ; zmniejszam granice o 1 dekrementujac
    46 00000050 7E43                        jle .writeResults ; skocz jesli mniejsze lub rowne 0
    47                                  
    48                                  .sortOuter:
    49 00000052 BE00000000                  mov rsi, 0 ; j 
    50 00000057 488D1C25[00000000]          lea rbx, [numbers]
    51                                  
    52                                  .sortInner:
    53                                  ; little-endian - najbardziej znaczace bajty i bity znaku sa zapisywane od tylu, pod wyzszym adresem
    54 0000005F 8B4304                      mov eax, dword [rbx + 4] ; porownuje gorne 32 bity pierwszego elementu
    55 00000062 3B430C                      cmp eax, dword [rbx + 8 + 4] ; rbx + 8 to nastepna liczba, +4 to jej gorna polowa
    56                                  
    57 00000065 7C19                        jl .skipSwap ; skocz jesli mniejsze skipuje
    58 00000067 7F07                        jg .swap ; skocz jesli wieksze -> swapuje
    59                                  
    60 00000069 8B03                        mov eax, dword [rbx]            
    61 0000006B 3B4308                      cmp eax, dword [rbx + 8]        
    62 0000006E 7610                        jbe .skipSwap
    63                                  
    64                                  .swap:
    65                                  
    66                                  ; dolna czesc - bity 0-31, 0
    67                                  
    68                                  ; xchg - exchange
    69 00000070 8B03                        mov eax, dword [rbx] ; kopiuje 4 najnizsze bajty elementu A do eax 
    70 00000072 874308                      xchg eax, dword [rbx + 8] ; wymieniam zawartosc eax z najnizszymi 4 bajtami elementu B
    71 00000075 8903                        mov dword [rbx], eax ; zapisuje wartosc z B w miejsce A
    72                                  
    73                                  ; gorna czesc - bity 32-63, 4
    74                                  
    75 00000077 8B4304                      mov eax, dword [rbx + 4] ; to samo, co powyzej
    76 0000007A 87430C                      xchg eax, dword [rbx + 8 + 4]
    77 0000007D 894304                      mov dword [rbx + 4], eax
    78                                  
    79                                  
    80                                  .skipSwap:
    81                                  
    82 00000080 4883C308                    add rbx, BYTES_PER_NUMBER ; przesuwam adres w pamieci, by wskazac kolejny element tab
    83 00000084 48FFC6                      inc rsi ; j++
    84 00000087 4839FE                      cmp rsi, rdi ; porownuje j z granica przesuwania N-1
    85 0000008A 72D3                        jb .sortInner ; skocz jesli nizsze j < N - 1
    86 0000008C 48FFCF                      dec rdi ; dekrementuje by zmniejszyc zakres przeszukiwania omijajac ostatni posortowany juz element
    87 0000008F 4883FF00                    cmp rdi, 0 ; sprawdzam czy cos jeszcze zostalo do posortowania
    88 00000093 7FBD                        jg .sortOuter ; powtarzam sortowanie
    89                                  
    90                                  .writeResults:
    91 00000095 B801000000                  mov rax, WRITE_NR
    92 0000009A BF01000000                  mov rdi, STDOUT ; deskryptor pliku wyjscie ekran
    93 0000009F 48BE-                       mov rsi, numbers ; adres tablicy z posortowanymi liczbami
    93 000000A1 [0000000000000000] 
    94 000000A9 488B1425[00000008]          mov rdx, [nBytes] ; liczba bajtow do wypisania
    95 000000B1 0F05                        syscall
    96 000000B3 B800000000                  mov rax, 0 ; kod sukcesu
    97 000000B8 EB0E                        jmp .endProgram
    98                                  
    99                                  .noDataRead:
   100 000000BA B801000000                  mov rax, 1 ; kod bledu 1 -> rax
   101 000000BF EB07                        jmp .endProgram
   102                                  
   103                                  .wrongNumberOfBytes:
   104 000000C1 B802000000                  mov rax, 2 ; kod bledu 2 -> rax
   105 000000C6 EB00                        jmp .endProgram
   106                                  
   107                                  .endProgram:
   108 000000C8 4889EC                      mov rsp, rbp ; cofam wskaznik do stanu pierwotnego
   109 000000CB 5D                          pop rbp 
   110 000000CC C3                          ret
