     1                                  READ_NR equ 0 ; numer wywolania READ
     2                                  WRITE_NR equ 1 ; numer wywolania WRITE
     3                                  
     4                                  STDIN equ 0 ; wejscie - klawiatura
     5                                  STDOUT equ 1 ; weyjscie - ekran
     6                                  
     7                                  MAX_NUMBERS equ 1024*1024*16
     8                                  BYTES_PER_NUMBER equ 16 ; 128 bitow -> 16 bajtow
     9                                  MAX_BYTES equ MAX_NUMBERS * BYTES_PER_NUMBER
    10                                  
    11                                  ; ZMIENNE NIEZAINICJALIZOWANE - miejsce zarezerwowane wypelnione zerami
    12                                  section .bss
    13 00000000 <res 10000000h>             numbers resb MAX_BYTES ; tablica
    14 10000000 ????????????????            nBytes resq 1 ; 64 bity - poczworne slowo - licznik wczytanych bajtow
    15 10000008 ????????????????            nNumbers resq 1 ; 64 bity - liczba elementow (N)
    16                                  
    17                                  ; ciag liczb do testow: zzzzzzzzzzzzzzzzaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbgggggggggggggggg
    18                                  
    19                                  section .text
    20                                      global main
    21                                  
    22                                  main:
    23 00000000 55                          push rbp ; zapisuje wskaznik na stosie
    24 00000001 4889E5                      mov rbp, rsp ; nowy wskaznik
    25                                  
    26 00000004 B800000000                  mov rax, READ_NR ; READ
    27 00000009 BF00000000                  mov rdi, STDIN ; klawiatura
    28 0000000E 48BE-                       mov rsi, numbers ; zapis do tablicy
    28 00000010 [0000000000000000] 
    29 00000018 BA00000010                  mov rdx, MAX_BYTES ; limit rozmiaru
    30 0000001D 0F05                        syscall
    31                                  
    32 0000001F 48890425[00000010]          mov [nBytes], rax ; rax - zapisuje liczbe wczytanych bajtow 
    33 00000027 4883F801                    cmp rax, 1
    34 0000002B 0F8CB3000000                jl .noDataRead ; skocz, jesli mniejsze rax < 1
    35                                  
    36 00000031 BB10000000                  mov rbx, BYTES_PER_NUMBER
    37 00000036 4831D2                      xor rdx, rdx ; 
    38 00000039 48F7F3                      div rbx
    39                                  
    40 0000003C 4883FA00                    cmp rdx, 0
    41 00000040 0F85A5000000                jne .wrongNumberOfBytes ; skocz jesli nie rowne
    42                                  
    43 00000046 48890425[08000010]          mov [nNumbers], rax ; rax zawiera teraz wyliczone N 
    44                                  
    45 0000004E 4889C7                      mov rdi, rax ; rdi - granica N w petli 
    46 00000051 48FFCF                      dec rdi ; zmniejszam granice o 1 dekrementujac
    47 00000054 7E69                        jle .writeResults ; skocz jesli mniejsze lub rowne 0
    48                                  
    49                                  .sortOuter:
    50 00000056 BE00000000                  mov rsi, 0 ; j 
    51 0000005B 488D1C25[00000000]          lea rbx, [numbers]
    52                                  
    53                                  
    54                                  .sortInner:
    55                                  ; najwyzsza czesc - bity 96-127, 12
    56                                  ; tu znajduje sie msb - bit znaku
    57 00000063 8B430C                      mov eax, dword [rbx + 12] ; kopiuje gorne 32 bity pierwszego elementu
    58 00000066 3B431C                      cmp eax, dword [rbx + 16 + 12] ; porownuje z gornymi 32 bitami kolejnego elementu
    59                                  
    60 00000069 7C3F                        jl .skipSwap ; skocz jesli mniejsze
    61 0000006B 7F1B                        jg .swap ; skocz jesli wieksze -> swapuje
    62                                  
    63                                  ; trzecia czesc - bity 64-95, 8
    64 0000006D 8B4308                      mov eax, dword [rbx + 8] 
    65 00000070 3B4318                      cmp eax, dword [rbx + 16 + 8] 
    66                                  
    67 00000073 7235                        jb .skipSwap ; skocz jesli nizsze
    68 00000075 7711                        ja .swap ; skocz jesli wyzsze
    69                                  
    70                                  ; druga czesc - bity 32-63, 4
    71 00000077 8B4304                      mov eax, dword [rbx + 4] 
    72 0000007A 3B4314                      cmp eax, dword [rbx + 16 + 4] 
    73                                  
    74 0000007D 722B                        jb .skipSwap ; skocz jesli nizsze
    75 0000007F 7707                        ja .swap ; skocz jesli wyzsze
    76                                  
    77                                  ; najnizsza czesc - bity 0-31, 0
    78 00000081 8B03                        mov eax, dword [rbx] 
    79 00000083 3B4310                      cmp eax, dword [rbx + 16] 
    80                                  
    81 00000086 7622                        jbe .skipSwap ; skocz jesli nizsze badz rowne, odnosi sie do cmp
    82                                  
    83                                  .swap:
    84                                  
    85                                  ; najnizsza czesc - bity 0-31, 0
    86                                  
    87                                  ; xchg - exchange
    88 00000088 8B03                        mov eax, dword [rbx] ; kopiuje 4 najnizsze bajty elementu A do eax 
    89 0000008A 874310                      xchg eax, dword [rbx + 16] ; wymieniam zawartosc eax z najnizszymi 4 bajtami elementu B
    90 0000008D 8903                        mov dword [rbx], eax ; zapisuje wartosc z B w miejsce A
    91                                  
    92                                  ; druga czesc - bity 32-63, 4
    93                                  
    94 0000008F 8B4304                      mov eax, dword [rbx + 4] ; to samo, co powyzej
    95 00000092 874314                      xchg eax, dword [rbx + 16 + 4]
    96 00000095 894304                      mov dword [rbx + 4], eax
    97                                  
    98                                  ; trzecia czesc - bity 64-95, 8
    99                                  
   100 00000098 8B4308                      mov eax, dword [rbx + 8]
   101 0000009B 874318                      xchg eax, dword [rbx + 16 + 8]
   102 0000009E 894308                      mov dword [rbx + 8], eax
   103                                  
   104                                  ; najwyzsza czesc - bity 96-127, 12
   105                                  
   106 000000A1 8B430C                      mov eax, dword [rbx + 12]
   107 000000A4 87431C                      xchg eax, dword [rbx + 16 + 12]
   108 000000A7 89430C                      mov dword [rbx + 12], eax
   109                                  
   110                                  .skipSwap:
   111                                  
   112 000000AA 4883C310                    add rbx, BYTES_PER_NUMBER ; przesuwam adres w pamieci, by wskazac kolejny element tab
   113 000000AE 48FFC6                      inc rsi ; j++
   114 000000B1 4839FE                      cmp rsi, rdi ; porownuje j z granica przesuwania N-1
   115 000000B4 72AD                        jb .sortInner ; skocz jesli nizsze j < N - 1
   116 000000B6 48FFCF                      dec rdi ; dekrementuje by zmniejszyc zakres przeszukiwania omijajac ostatni posortowany juz element
   117 000000B9 4883FF00                    cmp rdi, 0 ; sprawdzam czy cos jeszcze zostalo do posortowania
   118 000000BD 7F97                        jg .sortOuter ; powtarzam sortowanie
   119                                  
   120                                  .writeResults:
   121 000000BF B801000000                  mov rax, WRITE_NR
   122 000000C4 BF01000000                  mov rdi, STDOUT ; deskryptor pliku wyjscie ekran
   123 000000C9 48BE-                       mov rsi, numbers ; adres tablicy z posortowanymi liczbami
   123 000000CB [0000000000000000] 
   124 000000D3 488B1425[00000010]          mov rdx, [nBytes] ; liczba bajtow do wypisania
   125 000000DB 0F05                        syscall
   126 000000DD B800000000                  mov rax, 0 ; kod sukcesu
   127 000000E2 EB0E                        jmp .endProgram
   128                                  
   129                                  .noDataRead:
   130 000000E4 B801000000                  mov rax, 1 ; kod bledu 1 -> rax
   131 000000E9 EB07                        jmp .endProgram
   132                                  
   133                                  .wrongNumberOfBytes:
   134 000000EB B802000000                  mov rax, 2 ; kod bledu 2 -> rax
   135 000000F0 EB00                        jmp .endProgram
   136                                  
   137                                  .endProgram:
   138 000000F2 4889EC                      mov rsp, rbp ; cofam wskaznik do stanu pierwotnego
   139 000000F5 5D                          pop rbp 
   140 000000F6 C3                          ret
